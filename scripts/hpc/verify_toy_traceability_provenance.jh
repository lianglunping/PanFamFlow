#!/usr/bin/env bash
#JSUB -J panfamflow_toy_traceability_provenance
#JSUB -q normal
#JSUB -n 4
#JSUB -o logs/hpc/toy_traceability_provenance.%J.out
#JSUB -e logs/hpc/toy_traceability_provenance.%J.err

set -euo pipefail
cd "$JH_SUB_CWD"

module purge || true
module load anaconda3
module load singularity

engine="$JH_SUB_CWD/work/verified-engine-linux-64-198231"
toy_project_root="$JH_SUB_CWD/examples/toy_complete"
run_token="${JH_JOB_ID:-${LSB_JOBID:-${JOB_ID:-$$}}}"
validation_root="$JH_SUB_CWD/work/toy-traceability-provenance.${run_token}"
receipt="$validation_root/receipt.tsv"
run_log="$validation_root/run.log"
targets=(
  results/00_qc/id_mapping_audit.tsv
  results/01_normalized/canonical_transcript_provenance.tsv
  results/06_pan_family/hog_node_provenance.tsv
)

test -x "$engine/bin/python"
test -s "$JH_SUB_CWD/.snakemake/singularity/88970d61641c50285db96eb4521eb8ba.simg"
test ! -e "$validation_root"
mkdir -p "$validation_root"

preexisting_artifact_count=0
for target in "${targets[@]}"; do
  tsv_path="$toy_project_root/$target"
  xlsx_path="${toy_project_root}/${target%.tsv}.xlsx"
  if [[ -s "$tsv_path" && -s "$xlsx_path" ]]; then
    preexisting_artifact_count=$((preexisting_artifact_count + 1))
  elif [[ -e "$tsv_path" || -e "$xlsx_path" ]]; then
    printf 'PARTIAL_PROVENANCE_PAIR\t%s\n' "$target" >&2
    exit 96
  fi
done
test "$preexisting_artifact_count" -eq 0 || test "$preexisting_artifact_count" -eq 3

export PANFAMFLOW_CONDA_BASE_PATH="$JH_SUB_CWD/scripts/hpc/conda_compat"
export PATH="$JH_SUB_CWD/scripts/hpc/conda_compat/bin:$engine/bin:$PATH"
export PYTHONPATH="$JH_SUB_CWD/src${PYTHONPATH:+:$PYTHONPATH}"

python scripts/hpc/run_toy_complete.py \
  --conda-base-path "$JH_SUB_CWD/scripts/hpc/conda_compat" \
  --apptainer-prefix "$JH_SUB_CWD/.snakemake/singularity" \
  --target results/00_qc/id_mapping_audit.tsv \
  --target results/01_normalized/canonical_transcript_provenance.tsv \
  --target results/06_pan_family/hog_node_provenance.tsv \
  --target results/report/index.html 2>&1 | tee "$run_log"

for target in "${targets[@]}"; do
  test -s "$toy_project_root/$target"
  test -s "${toy_project_root}/${target%.tsv}.xlsx"
done

python scripts/hpc/verify_toy_traceability_provenance.py \
  "$toy_project_root" "$receipt" "$preexisting_artifact_count"
test -s "$receipt"
printf 'TOY_TRACEABILITY_PROVENANCE\tPASS\treceipt=%s\n' "$receipt"
