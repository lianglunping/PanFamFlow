SYNTENY_CONFIG = config.get("synteny", {})


def load_synteny_pairs():
    if not SYNTENY_CONFIG.get("enabled", False):
        return {}
    table_path = Path(str(SYNTENY_CONFIG.get("species_pairs_table")))
    if not table_path.is_file():
        raise FileNotFoundError(f"Configured synteny species-pair table does not exist: {table_path}")
    with table_path.open(encoding="utf-8", newline="") as handle:
        rows = list(csv.DictReader(handle, delimiter="\t"))
    required = {"pair_id", "species_1", "species_2"}
    if not rows:
        raise ValueError("Synteny species-pair table is empty.")
    missing = sorted(required.difference(rows[0]))
    if missing:
        raise ValueError(f"Synteny species-pair table lacks columns: {', '.join(missing)}")
    records = {}
    for layout_index, row in enumerate(rows, start=1):
        pair_id = str(row["pair_id"]).strip()
        if not re.fullmatch(r"[A-Za-z][A-Za-z0-9_.-]*", pair_id):
            raise ValueError(f"Invalid synteny pair_id: {pair_id!r}")
        if pair_id in records:
            raise ValueError(f"Duplicate synteny pair_id: {pair_id}")
        species_1 = str(row["species_1"]).strip()
        species_2 = str(row["species_2"]).strip()
        unknown = sorted({species_1, species_2}.difference(SPECIES_BY_ID))
        if unknown:
            raise ValueError(f"Synteny pair {pair_id} references unknown species: {unknown}")
        records[pair_id] = {
            **row,
            "pair_id": pair_id,
            "species_1": species_1,
            "species_2": species_2,
            "layout_order": int(row.get("layout_order") or layout_index),
            "include_overview": str(row.get("include_overview", "true")).lower()
            in {"1", "true", "yes", "y"},
        }
    representative = str(SYNTENY_CONFIG.get("representative_species"))
    if not any(
        row["species_1"] == representative and row["species_2"] == representative
        for row in records.values()
    ):
        raise ValueError(
            "Synteny pair table must contain one intragenome row for representative_species."
        )
    if not any(row["species_1"] != row["species_2"] for row in records.values()):
        raise ValueError("Synteny pair table must contain at least one inter-species pair.")
    return records


SYNTENY_PAIR_RECORDS = load_synteny_pairs()
SYNTENY_PAIR_IDS = list(SYNTENY_PAIR_RECORDS)
SYNTENY_TARGETS = (
