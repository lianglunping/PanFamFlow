def formal_activation_enabled(row):
    if row["module"] not in SELECTED_MODULES:
        return False
    activation = row["activation"]
    return {
        "pdf_md_complete": COMPLETE_PROFILE,
        "comparative_panel.enabled": bool(COMPARATIVE_PANEL.get("enabled", False)),
        "domain_logo.enabled": bool(config.get("domain_logo", {}).get("enabled", False)),
        "synteny.enabled": bool(SYNTENY_CONFIG.get("enabled", False)),
        "differential_expression.enabled": bool(DE_CONFIG.get("enabled", False)),
    }.get(activation, False)


FIGURE_CONTRACT_PATH = Path(workflow.basedir).parents[2] / "docs" / "FIGURE_CONTRACT.tsv"
with FIGURE_CONTRACT_PATH.open(encoding="utf-8", newline="") as handle:
    FIGURE_CONTRACT_ROWS = list(csv.DictReader(handle, delimiter="\t"))


def configured_result_path(path):
    candidate = Path(str(path))
    if not candidate.is_absolute() and candidate.parts[:1] == ("results",):
        candidate = Path(*candidate.parts[1:])
    return join_path(RESULTS, candidate)


FORMAL_FIGURE_TARGETS = sorted(
    {
        f"{configured_result_path(row['stem'])}.{suffix}"
        for row in FIGURE_CONTRACT_ROWS
        if formal_activation_enabled(row)
        for suffix in ("pdf", "png")
    }
)
FORMAL_SOURCE_TABLE_TARGETS = sorted(
    {
        configured_result_path(row["source_table"])
        for row in FIGURE_CONTRACT_ROWS
        if formal_activation_enabled(row)
    }
)
