def species_field(wildcards, field):
    return SPECIES_BY_ID[wildcards.species][field]


def sample_field(wildcards, field):
    return SAMPLE_BY_ID[wildcards.sample][field]


wildcard_constraints:
    species="|".join(SPECIES),
    sample="|".join(SAMPLES) if SAMPLES else r"a^",
    pair_id="|".join(re.escape(item) for item in SYNTENY_PAIR_IDS) if SYNTENY_PAIR_IDS else r"a^",

rule all:
    input:
        [MODULE_TARGETS[module] for module in SELECTED_MODULES]
        + COMPARATIVE_PHYLOGENY_TARGETS
        + COMPLETE_CHROMOSOME_TARGETS
        + SYNTENY_TARGETS
        + DE_TARGETS
        + FORMAL_FIGURE_TARGETS
        + FORMAL_SOURCE_TABLE_TARGETS
        + FORMAL_TABLE_COMPANION_TARGETS
        + RECOVERY_AUDIT_TARGETS


